app/src/main/python/harbor_diagnostics.py text eol=lf

app/src/main/python/harbor_android.py text eol=lf

tools/sync_gpmc.py text eol=lf
gpmc.lock.json text eol=lf

# The historical dependency manifest pins LICENSE as LF bytes on every OS.
LICENSE text eol=lf
