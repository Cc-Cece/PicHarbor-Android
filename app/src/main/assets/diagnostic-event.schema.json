{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:picharbor:diagnostics:event:1",
  "title": "PicHarbor diagnostics event envelope v1 (design)",
  "description": "Envelope only. Event-specific attrs require a versioned allowlist registry; schema validity does not imply safe redaction.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "event_id", "event", "level", "platform", "component", "build_id", "session_id", "producer_id", "seq", "boot_id", "ts_utc", "mono_ms", "clock_source", "trace_id", "span_id", "attrs"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_version": {"type": "integer", "minimum": 1},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "event": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$", "maxLength": 96},
    "level": {"enum": ["DEBUG", "INFO", "WARN", "ERROR", "FATAL"]},
    "platform": {"enum": ["android", "ios", "desktop"]},
    "component": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$", "maxLength": 64},
    "build_id": {"$ref": "#/$defs/safeId"},
    "session_id": {"$ref": "#/$defs/safeId"},
    "producer_id": {"$ref": "#/$defs/safeId"},
    "boot_id": {"$ref": "#/$defs/safeId"},
    "seq": {"type": "integer", "minimum": 1},
    "ts_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "mono_ms": {"type": "number", "minimum": 0},
    "clock_source": {"enum": ["android_elapsed_realtime", "calibrated_python_monotonic", "platform_monotonic"]},
    "clock_uncertainty_ms": {"type": "number", "minimum": 0},
    "trace_id": {"$ref": "#/$defs/traceId"},
    "span_id": {"$ref": "#/$defs/spanId"},
    "parent_span_id": {"$ref": "#/$defs/spanId"},
    "links": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["trace_id", "span_id"], "properties": {"trace_id": {"$ref": "#/$defs/traceId"}, "span_id": {"$ref": "#/$defs/spanId"}}}},
    "job_id": {"$ref": "#/$defs/safeId"},
    "item_id": {"$ref": "#/$defs/safeId"},
    "resource_id": {"$ref": "#/$defs/safeId"},
    "run_id": {"$ref": "#/$defs/safeId"},
    "attempt_id": {"$ref": "#/$defs/safeId"},
    "request_id": {"$ref": "#/$defs/safeId"},
    "incident_id": {"$ref": "#/$defs/safeId"},
    "error_id": {"$ref": "#/$defs/safeId"},
    "truncated": {"type": "boolean"},
    "attrs": {"type": "object", "maxProperties": 48}
  },
  "$defs": {
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$", "not": {"const": "00000000000000000000000000000000"}},
    "spanId": {"type": "string", "pattern": "^[0-9a-f]{16}$", "not": {"const": "0000000000000000"}}
  }
}
