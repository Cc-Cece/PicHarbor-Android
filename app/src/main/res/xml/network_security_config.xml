<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- User-entered proxy subscriptions may use HTTP, matching iOS.
         Google authentication/upload endpoints remain fixed HTTPS in code. -->
    <base-config cleartextTrafficPermitted="true"><trust-anchors><certificates src="system" /></trust-anchors></base-config>
    <domain-config cleartextTrafficPermitted="true"><domain includeSubdomains="false">127.0.0.1</domain><domain includeSubdomains="false">localhost</domain></domain-config>
</network-security-config>
